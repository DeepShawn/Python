{
  "name": "python-nexus",
  "version": "0.2.0",
  "private": true,
  "description": "Python Nexus — 全平台离线 Python 学习与开发系统（网页版 / Windows / Android）",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "bank": "python3 tools/build_question_bank.py",
    "serve": "python3 -m http.server 8000 --directory web",
    "test": "python3 -m unittest discover -s tests -v",
    "test:e2e": "node scripts/e2e.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "android:init": "tauri android init",
    "android:build": "tauri android build --apk",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.8",
    "@lezer/highlight": "^1.2.1",
    "@tauri-apps/cli": "^2.12.3",
    "blockly": "^11.2.2",
    "esbuild": "^0.25.12",
    "hash-wasm": "^4.12.0",
    "pyodide": "0.27.7",
    "tweetnacl": "^1.0.3"
  }
}
