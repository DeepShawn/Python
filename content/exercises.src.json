{
  "version": 1,
  "questions": [
    {
      "id": "q-print-1",
      "stage": "零基础",
      "type": "single",
      "title": "下面哪一行代码能在屏幕上输出 Hello？",
      "options": [
        "echo Hello",
        "print(\"Hello\")",
        "printf(Hello)",
        "console.log(\"Hello\")"
      ],
      "answer": "1",
      "explain": "Python 使用内置函数 print() 输出内容，字符串需要用引号包裹。"
    },
    {
      "id": "q-type-1",
      "stage": "零基础",
      "type": "single",
      "title": "type(3.0) 的结果是？",
      "options": [
        "<class 'int'>",
        "<class 'float'>",
        "<class 'str'>",
        "<class 'double'>"
      ],
      "answer": "1",
      "explain": "带小数点的数字是浮点数 float；Python 没有 double 类型。"
    },
    {
      "id": "q-container-1",
      "stage": "基础语法",
      "type": "multi",
      "title": "以下哪些是可变（mutable）类型？（多选）",
      "options": [
        "list",
        "tuple",
        "dict",
        "str",
        "set"
      ],
      "answer": [
        "0",
        "2",
        "4"
      ],
      "explain": "list、dict、set 可以原地修改；tuple 和 str 是不可变类型。"
    },
    {
      "id": "q-fill-len",
      "stage": "基础语法",
      "type": "fill",
      "title": "填空：len([1, 2, 3]) 的值是 ____。",
      "answer": "3",
      "explain": "len() 返回容器中元素的个数。"
    },
    {
      "id": "q-fill-range",
      "stage": "基础语法",
      "type": "fill",
      "title": "填空：list(range(2, 8, 3)) 的结果是 ____（按 Python 显示格式填写）。",
      "answers": [
        "[2, 5]",
        "[2,5]"
      ],
      "explain": "range(start, stop, step)：从 2 开始，每次加 3，不包含 8，所以是 2 和 5。"
    },
    {
      "id": "q-scope-1",
      "stage": "函数编程",
      "type": "single",
      "title": "作用域：下面代码的运行结果是？",
      "options": [
        "1",
        "None",
        "NameError",
        "0"
      ],
      "answer": "2",
      "explain": "x 是函数内的局部变量，函数外无法访问，因此抛出 NameError。",
      "code": "def f():\n    x = 1\n\nf()\nprint(x)"
    },
    {
      "id": "p-sum",
      "stage": "零基础",
      "type": "code_io",
      "title": "两数之和",
      "prompt": "读入两行整数 a 和 b，输出它们的和。",
      "starter": "a = int(input())\nb = int(input())\n# 在下面输出 a 与 b 的和\n",
      "cases": [
        {
          "stdin": "1\n2",
          "expected": "3"
        },
        {
          "stdin": "-5\n10",
          "expected": "5"
        },
        {
          "stdin": "100\n250",
          "expected": "350",
          "hidden": true
        }
      ]
    },
    {
      "id": "p-parity",
      "stage": "基础语法",
      "type": "code_io",
      "title": "判断奇偶",
      "prompt": "读入一个整数 n，若 n 为偶数输出“偶数”，否则输出“奇数”。",
      "starter": "n = int(input())\n",
      "cases": [
        {
          "stdin": "4",
          "expected": "偶数"
        },
        {
          "stdin": "7",
          "expected": "奇数"
